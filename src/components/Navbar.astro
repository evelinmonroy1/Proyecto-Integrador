---
const { activo = "" } = Astro.props;
---
<header class="navbar">
  <a class="marca" href="/" aria-label="Inicio">
    <svg viewBox="0 0 40 40" aria-hidden="true">
      <g fill="#a7b9cd">
        <ellipse cx="20" cy="8" rx="5.5" ry="7.5" />
        <ellipse cx="20" cy="32" rx="5.5" ry="7.5" />
        <ellipse cx="8" cy="20" rx="7.5" ry="5.5" />
        <ellipse cx="32" cy="20" rx="7.5" ry="5.5" />
        <ellipse cx="11.5" cy="11.5" rx="5.5" ry="7" transform="rotate(-45 11.5 11.5)" />
        <ellipse cx="28.5" cy="28.5" rx="5.5" ry="7" transform="rotate(-45 28.5 28.5)" />
        <ellipse cx="28.5" cy="11.5" rx="5.5" ry="7" transform="rotate(45 28.5 11.5)" />
        <ellipse cx="11.5" cy="28.5" rx="5.5" ry="7" transform="rotate(45 11.5 28.5)" />
      </g>
      <circle cx="20" cy="20" r="6" fill="#fff" />
    </svg>
    Lotería <span>Mazahua</span>
  </a>
  <nav>
    <a class={`enlace ${activo === "inicio" ? "activo" : ""}`} href="/">Inicio</a>
  </nav>
  <div class="derecha">
    <a class="boton-nav amarillo" href="/jugar">Jugar</a>
    <a class="boton-nav" href="/admin">Administrador</a>
  </div>
</header>
