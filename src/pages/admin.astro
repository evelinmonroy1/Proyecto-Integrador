---
import Navbar from "../components/Navbar.astro";
import Base from "../layouts/Base.astro";
import AdminPartida from "../components/AdminPartida.svelte";
---
<Base titulo="Administrador · Lotería Mazahua">
  <Navbar />
  <main>
    <header>
      <a href="/">← Inicio</a>
      <h1>Panel del administrador</h1>
      <div class="acciones">
        <a class="palabras" href="/admin/palabras">📚 Administrar palabras</a>
        <a class="palabras" href="/admin/tarjetas">🏷️ Vincular tarjetas</a>
        <button id="salir" type="button">Cerrar sesión</button>
      </div>
    </header>
    <AdminPartida client:load />
  </main>
</Base>

<script>
  import { cerrarSesion } from "../lib/auth.js";
  document.getElementById("salir")?.addEventListener("click", cerrarSesion);
</script>

<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  header a {
    color: var(--verde);
    font-weight: bold;
  }
  h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }
  .palabras {
    align-self: flex-start;
    padding: 0.5rem 1rem;
    border: 2px solid var(--verde);
    border-radius: 12px;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
  }
  #salir {
    margin-left: auto;
    padding: 0.5rem 1rem;
    border: 2px solid #b00020;
    color: #b00020;
    background: transparent;
    border-radius: 12px;
    font-weight: bold;
    cursor: pointer;
  }
  #salir:hover { background: #b00020; color: white; }
  .palabras:hover {
    background: var(--verde);
    color: white;
  }
</style>