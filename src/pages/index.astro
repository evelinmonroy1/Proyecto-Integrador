---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import EstadoApi from "../components/EstadoApi.svelte";
---
<Base titulo="Lotería Mazahua">
  <main>
    <Navbar activo="inicio" />

    <section class="portada">
      <div class="texto">
        <h1><span class="a">Lotería</span><span class="b">Mazahua</span></h1>
        <p class="lema">Aprende, juega y conserva nuestra lengua</p>

        <div class="opciones">
          <a class="opcion admin" href="/admin">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19.4 13a7.9 7.9 0 0 0 0-2l2.1-1.6-2-3.4-2.5 1a7.6 7.6 0 0 0-1.7-1L15 3.3h-4l-.4 2.7a7.6 7.6 0 0 0-1.7 1l-2.5-1-2 3.4L6.6 11a7.9 7.9 0 0 0 0 2l-2.1 1.6 2 3.4 2.5-1c.5.4 1.1.7 1.7 1l.4 2.7h4l.4-2.7c.6-.3 1.2-.6 1.7-1l2.5 1 2-3.4zM13 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z"/></svg>
            <strong>Administrador</strong>
            <small>Crea y controla la partida</small>
            <span class="flecha">→</span>
          </a>

          <a class="opcion jugador" href="/jugar">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 8h10a5 5 0 0 1 4.9 4l.9 4.4a2.6 2.6 0 0 1-4.5 2.2L16.5 16h-9L5.7 18.6A2.6 2.6 0 0 1 1.2 16.4l.9-4.4A5 5 0 0 1 7 8zm.5 2.5v1.2H6.3v1.6h1.2v1.2h1.6v-1.2h1.2v-1.6H9.1v-1.2zm8.4.4a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm2 1.6a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/></svg>
            <strong>Jugador</strong>
            <small>Entra con tu código</small>
            <span class="flecha">→</span>
          </a>
        </div>
      </div>

      <img class="heroe" src="/hero.svg" alt="Niña mazahua mostrando una tarjeta de lotería" />
    </section>

    <footer>
      <EstadoApi client:load />
    </footer>

    <div class="franja"></div>
  </main>
</Base>

<style>
  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .portada {
    flex: 1;
    width: 100%;
    max-width: 1150px;
    margin: 0 auto;
    padding: 2.5rem 1.4rem 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 1.5rem;
  }
  h1 {
    display: flex;
    flex-direction: column;
    font-weight: 800;
    line-height: 0.95;
  }
  .a { font-size: clamp(3rem, 8vw, 5.6rem); color: var(--cafe); }
  .b { font-size: clamp(3.4rem, 9.5vw, 6.8rem); color: var(--verde); }
  .lema {
    margin: 1rem 0 2rem;
    font-size: clamp(1.1rem, 2.6vw, 1.5rem);
    color: var(--tinta);
    display: inline-block;
    padding-bottom: 0.5rem;
    background: linear-gradient(var(--terracota), var(--terracota)) no-repeat left bottom / 82% 5px;
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }
  .opcion {
    position: relative;
    flex: 1 1 230px;
    min-width: 220px;
    padding: 1.6rem 1.4rem 1.4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-align: center;
    border-radius: var(--radio);
    color: white;
    border: 4px solid white;
    box-shadow: var(--sombra);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .opcion:hover { transform: translateY(-4px); box-shadow: 0 16px 34px rgba(15, 53, 87, 0.24); }
  .opcion:active { transform: translateY(1px); }
  .opcion svg { width: 42px; height: 42px; }
  .admin { background: var(--cafe); }
  .jugador { background: var(--celeste); }
  strong { font-size: 1.4rem; font-weight: 700; }
  small { opacity: 0.95; font-size: 0.95rem; }
  .flecha {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: white;
    color: var(--cafe);
    font-weight: 700;
  }
  .heroe { width: 100%; height: auto; max-height: 520px; justify-self: center; }
  footer { display: flex; justify-content: center; padding: 0.8rem; }

  @media (max-width: 860px) {
    .portada { grid-template-columns: 1fr; text-align: center; padding-top: 1.5rem; }
    .heroe { order: -1; max-width: 340px; }
    h1 { align-items: center; }
    .opciones { justify-content: center; }
    .flecha { display: none; }
  }
</style>
