---
import Base from "../layouts/Base.astro";
import EstadoApi from "../components/EstadoApi.svelte";

// Página de inicio. Tiene su propia barra y su propio diseño;
// no cambia nada del juego ni de las otras secciones.
const secciones = [
  { href: "/", texto: "Inicio", icono: "casa", activa: true },
  { href: "/lengua", texto: "La lengua", icono: "mundo" },
  { href: "/galeria", texto: "Galería", icono: "imagen" },
  { href: "/videos", texto: "Videos", icono: "video" },
];

const explorar = [
  { href: "/lengua", titulo: "La lengua mazahua", texto: "Conoce más sobre nuestra lengua", icono: "libro" },
  { href: "/galeria", titulo: "Galería", texto: "Descubre nuestro vocabulario", icono: "imagen" },
  { href: "/videos", titulo: "Videos", texto: "Aprende con nosotros", icono: "video" },
];
---
<Base titulo="Lotería Mazahua">
  <div class="tema-inicio">
    <!-- Dibujos reutilizables (iconos y flor) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="i-flor" viewBox="0 0 48 48">
          <g fill="currentColor">
            <ellipse cx="24" cy="10" rx="6" ry="10" />
            <ellipse cx="24" cy="10" rx="6" ry="10" transform="rotate(45 24 24)" />
            <ellipse cx="24" cy="10" rx="6" ry="10" transform="rotate(90 24 24)" />
            <ellipse cx="24" cy="10" rx="6" ry="10" transform="rotate(135 24 24)" />
            <ellipse cx="24" cy="10" rx="6" ry="10" transform="rotate(180 24 24)" />
            <ellipse cx="24" cy="10" rx="6" ry="10" transform="rotate(225 24 24)" />
            <ellipse cx="24" cy="10" rx="6" ry="10" transform="rotate(270 24 24)" />
            <ellipse cx="24" cy="10" rx="6" ry="10" transform="rotate(315 24 24)" />
          </g>
          <circle cx="24" cy="24" r="6" fill="#ffffff" />
        </symbol>
        <symbol id="i-casa" viewBox="0 0 24 24"><path fill="currentColor" d="M12 3 2 11.5h3V21h5.5v-6h3v6H19v-9.5h3z" /></symbol>
        <symbol id="i-mundo" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18" /></g></symbol>
        <symbol id="i-imagen" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m4 18 5.5-6 4 4.5 2.5-2.5L20 18" /><circle cx="15.5" cy="8.5" r="1.6" /></g></symbol>
        <symbol id="i-video" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="4" fill="currentColor" /><path d="M10 8.5v7l6-3.5z" fill="#ffffff" /></symbol>
        <symbol id="i-escudo" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5z" /><path fill="#f2c14e" d="m12 7 1.4 2.9 3.1.4-2.3 2.2.6 3.1-2.8-1.5-2.8 1.5.6-3.1-2.3-2.2 3.1-.4z" /></symbol>
        <symbol id="i-persona" viewBox="0 0 24 24"><g fill="currentColor"><circle cx="12" cy="7.5" r="4.5" /><path d="M3.5 21c0-4.7 3.8-7.5 8.5-7.5s8.5 2.8 8.5 7.5z" /></g></symbol>
        <symbol id="i-engrane" viewBox="0 0 24 24">
          <g fill="currentColor">
            <rect x="10" y="1" width="4" height="5" rx="1" />
            <rect x="10" y="1" width="4" height="5" rx="1" transform="rotate(45 12 12)" />
            <rect x="10" y="1" width="4" height="5" rx="1" transform="rotate(90 12 12)" />
            <rect x="10" y="1" width="4" height="5" rx="1" transform="rotate(135 12 12)" />
            <rect x="10" y="1" width="4" height="5" rx="1" transform="rotate(180 12 12)" />
            <rect x="10" y="1" width="4" height="5" rx="1" transform="rotate(225 12 12)" />
            <rect x="10" y="1" width="4" height="5" rx="1" transform="rotate(270 12 12)" />
            <rect x="10" y="1" width="4" height="5" rx="1" transform="rotate(315 12 12)" />
            <circle cx="12" cy="12" r="7.5" />
          </g>
          <circle cx="12" cy="12" r="3" fill="var(--hueco, #143b61)" />
        </symbol>
        <symbol id="i-control" viewBox="0 0 24 24">
          <path fill="currentColor" d="M7 6h10a5 5 0 0 1 4.9 4l1 5.2a3 3 0 0 1-5.3 2.4L15.5 16h-7l-2.1 1.6a3 3 0 0 1-5.3-2.4l1-5.2A5 5 0 0 1 7 6z" />
          <g fill="var(--hueco, #457caa)"><rect x="6.2" y="8.6" width="1.8" height="5.4" rx=".5" /><rect x="4.4" y="10.4" width="5.4" height="1.8" rx=".5" /><circle cx="16" cy="9.6" r="1.1" /><circle cx="18" cy="11.6" r="1.1" /><circle cx="14" cy="11.6" r="1.1" /><circle cx="16" cy="13.6" r="1.1" /></g>
        </symbol>
        <symbol id="i-libro" viewBox="0 0 48 48"><g fill="currentColor"><path d="M4 10c6-1.5 12-1 18 2v28c-6-3-12-3.5-18-2z" /><path d="M44 10c-6-1.5-12-1-18 2v28c6-3 12-3.5 18-2z" /></g><path d="M8 16c4-.8 7.5-.4 10.5 1M8 21c4-.8 7.5-.4 10.5 1M8 26c4-.8 7.5-.4 10.5 1M29.5 17c3-1.4 6.5-1.8 10.5-1M29.5 22c3-1.4 6.5-1.8 10.5-1M29.5 27c3-1.4 6.5-1.8 10.5-1" stroke="#ffffff" stroke-width="1.6" fill="none" stroke-linecap="round" /></symbol>
        <symbol id="i-flecha" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="currentColor" /><path d="M7 12h9m-3.5-4 4 4-4 4" fill="none" stroke="var(--hueco, #ffffff)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></symbol>
        <symbol id="i-hoja" viewBox="0 0 60 80"><g fill="currentColor"><path d="M30 80C24 55 26 30 34 6c6 22 4 48-4 74z" /><path d="M28 78C12 64 4 46 6 26c14 14 22 32 22 52z" /><path d="M32 78c16-12 24-30 22-50-14 14-22 30-22 50z" /></g></symbol>
        <pattern id="p-greca" width="56" height="56" patternUnits="userSpaceOnUse">
          <rect width="56" height="56" fill="#143b61" />
          <g fill="none" stroke="#589ac4" stroke-width="3">
            <path d="M28 4 52 28 28 52 4 28z" />
            <path d="M28 14 42 28 28 42 14 28z" />
          </g>
          <path d="M28 23 33 28 28 33 23 28z" fill="#589ac4" />
        </pattern>
      </defs>
    </svg>

    <!-- Barra -->
    <header class="barra">
      <a class="marca" href="/">
        <svg class="logo"><use href="#i-flor" /></svg>
        Lotería <span>Mazahua</span>
      </a>
      <nav aria-label="Secciones">
        <ul>
          {secciones.map((s) => (
            <li>
              <a href={s.href} class:list={[{ activa: s.activa }]} aria-current={s.activa ? "page" : undefined}>
                <svg class="ico"><use href={`#i-${s.icono}`} /></svg>
                {s.texto}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="accesos">
        <a class="pildora jugar" href="/jugar"><svg class="ico"><use href="#i-escudo" /></svg>Jugar</a>
        <a class="pildora admin" href="/admin"><svg class="ico"><use href="#i-persona" /></svg>Administrador</a>
      </div>
    </header>

    <main>
      <!-- Flores decorativas a los lados -->
      <svg class="petalos izq" aria-hidden="true"><use href="#i-flor" /></svg>
      <svg class="petalos der" aria-hidden="true"><use href="#i-flor" /></svg>

      <section class="portada">
        <div class="titulo">
          <svg class="rayitas amarillas" viewBox="0 0 60 60" aria-hidden="true">
            <path d="M40 6 50 22M18 18l22 12M8 40l26-2" />
          </svg>
          <svg class="rayitas azules" viewBox="0 0 60 60" aria-hidden="true">
            <path d="M20 6 10 22M42 18 20 30M52 40l-26-2" />
          </svg>
          <h1>
            <span class="l1">Lotería</span>
            <span class="l2">Mazahua</span>
          </h1>
          <p class="lema">Aprende, juega y conserva nuestra lengua</p>
          <svg class="subrayado" viewBox="0 0 260 14" aria-hidden="true">
            <path d="M4 10C70 2 180 0 256 7" />
          </svg>
        </div>
        <div class="ilustracion">
          <img src="/nina-loteria.png" alt="Niña mazahua con traje tradicional sosteniendo una tarjeta de la lotería" />
        </div>
      </section>

      <section class="opciones">
        <a class="opcion admin" href="/admin">
          <svg class="hoja" aria-hidden="true"><use href="#i-hoja" /></svg>
          <svg class="icono"><use href="#i-engrane" /></svg>
          <strong>Administrador</strong>
          <small>Crea y controla la partida</small>
          <svg class="flecha"><use href="#i-flecha" /></svg>
        </a>
        <a class="opcion jugador" href="/jugar">
          <svg class="hoja" aria-hidden="true"><use href="#i-hoja" /></svg>
          <svg class="icono"><use href="#i-control" /></svg>
          <strong>Jugador</strong>
          <small>Entra con tu código</small>
          <svg class="flecha"><use href="#i-flecha" /></svg>
        </a>
      </section>

      <section class="explorar">
        <div class="separador">
          <span class="linea"></span>
          <svg class="florcita" aria-hidden="true"><use href="#i-flor" /></svg>
          <span class="linea"></span>
        </div>
        <h2>Explora y aprende</h2>
        <div class="tarjetas">
          {explorar.map((e) => (
            <a class="tarjeta" href={e.href}>
              <svg class="icono-tarjeta"><use href={`#i-${e.icono}`} /></svg>
              <div class="texto">
                <h3>{e.titulo}</h3>
                <p>{e.texto}</p>
              </div>
              <svg class="flecha"><use href="#i-flecha" /></svg>
              <svg class="ola" viewBox="0 0 400 30" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 30V18C80 4 160 4 220 14s120 14 180-2v18z" />
              </svg>
            </a>
          ))}
        </div>
      </section>

      <div class="estado-servidor">
        <EstadoApi client:load />
      </div>
    </main>

    <!-- Pie con ola y greca -->
    <footer class="pie">
      <svg class="ola-pie" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 60V30C240 0 480 0 720 22s480 30 720 0v38z" />
      </svg>
      <svg class="greca" aria-hidden="true"><rect width="100%" height="100%" fill="url(#p-greca)" /></svg>
    </footer>
  </div>
</Base>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:wght@400;600;700&display=swap");

  .tema-inicio {
    /* Paleta */
    --marino: #143b61;
    --azul: #1f5c94;
    --medio: #457caa;
    --cielo: #589ac4;
    --gris: #99b2c7;
    --claro: #d2dee7;
    --hielo: #e8eef5;
    --crema: #f5f7fa;
    --mostaza: #f2c14e;

    --titulos: "Baloo 2", "Nunito", system-ui, sans-serif;
    --texto: "Nunito", "Segoe UI", system-ui, sans-serif;

    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    background: var(--crema);
    color: var(--marino);
    font-family: var(--texto);
  }

  /* ---------------- Barra ---------------- */
  .barra {
    position: relative;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.6rem;
    padding: 0.9rem clamp(1rem, 3vw, 2.2rem);
    background: var(--marino);
    border-radius: 0 0 30px 30px;
    box-shadow: 0 6px 18px rgba(20, 59, 97, 0.25);
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-right: 1.6rem;
    border-right: 1px solid rgba(255, 255, 255, 0.25);
    font-family: var(--titulos);
    font-size: 1.7rem;
    font-weight: 700;
    color: white;
    line-height: 1;
  }
  .marca span {
    color: #a9c9e6;
  }
  .logo {
    width: 2.6rem;
    height: 2.6rem;
    color: #7fb1dd;
  }
  .barra ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .barra nav a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    font-weight: 700;
    color: white;
    transition: background 0.2s;
  }
  .barra nav a:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .barra nav a.activa {
    background: var(--hielo);
    color: var(--marino);
  }
  .ico {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }
  .accesos {
    display: flex;
    gap: 0.7rem;
    margin-left: auto;
  }
  .pildora {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.4rem;
    border-radius: 999px;
    font-weight: 700;
    color: var(--marino);
    transition: transform 0.2s;
  }
  .pildora:hover {
    transform: translateY(-2px);
  }
  .jugar {
    background: var(--mostaza);
  }
  .admin.pildora {
    background: var(--hielo);
  }

  /* ---------------- Decoración ---------------- */
  main {
    position: relative;
    flex: 1;
  }
  .petalos {
    position: absolute;
    top: 2rem;
    width: 320px;
    height: 320px;
    color: var(--claro);
    opacity: 0.8;
    pointer-events: none;
  }
  .petalos.izq {
    left: -190px;
  }
  .petalos.der {
    right: -200px;
    top: 9rem;
  }

  /* ---------------- Portada ---------------- */
  .portada {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: end;
    gap: 1rem;
  }
  .titulo {
    position: relative;
    text-align: center;
    padding: 1.5rem 0 0;
  }
  h1 {
    margin: 0;
    font-family: var(--titulos);
    font-weight: 800;
    line-height: 0.82;
  }
  .l1 {
    display: block;
    font-size: clamp(3.2rem, 8vw, 6rem);
    color: var(--marino);
  }
  .l2 {
    display: block;
    font-size: clamp(4rem, 11vw, 8.2rem);
    color: var(--azul);
  }
  .lema {
    margin: 1.2rem 0 0;
    font-family: var(--titulos);
    font-size: clamp(1.2rem, 2.6vw, 1.8rem);
    font-weight: 500;
    color: var(--marino);
  }
  .subrayado {
    display: block;
    width: 260px;
    max-width: 60%;
    height: 14px;
    margin: 0.4rem auto 0;
  }
  .subrayado path {
    fill: none;
    stroke: var(--mostaza);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .rayitas {
    position: absolute;
    width: 64px;
    height: 64px;
  }
  .rayitas path {
    fill: none;
    stroke-width: 7;
    stroke-linecap: round;
  }
  .amarillas {
    left: 2%;
    top: 0;
  }
  .amarillas path {
    stroke: var(--mostaza);
  }
  .azules {
    right: 2%;
    top: 0;
  }
  .azules path {
    stroke: var(--azul);
  }

  .ilustracion {
    position: relative;
    align-self: end;
  }
  .ilustracion img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------------- Accesos al juego ---------------- */
  .opciones {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 420px));
    justify-content: center;
    gap: 1.8rem;
    margin-top: 1.2rem;
    padding: 0 1.5rem;
  }
  .opcion {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.2rem 3.5rem 1.3rem;
    overflow: hidden;
    border: 3px solid white;
    border-radius: 22px;
    color: white;
    text-align: center;
    box-shadow: 0 10px 24px -8px rgba(20, 59, 97, 0.45);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .opcion:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 30px -10px rgba(20, 59, 97, 0.55);
  }
  .opcion.admin {
    background: var(--marino);
    --hueco: var(--marino);
  }
  .opcion.jugador {
    background: var(--medio);
    --hueco: var(--medio);
  }
  .opcion .icono {
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.3rem;
  }
  .opcion strong {
    font-family: var(--titulos);
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.1;
  }
  .opcion small {
    font-size: 1.02rem;
    font-weight: 600;
    opacity: 0.95;
  }
  .opcion .flecha {
    position: absolute;
    right: 1.4rem;
    top: 50%;
    width: 2.3rem;
    height: 2.3rem;
    margin-top: -1.15rem;
    color: white;
  }
  .opcion.admin .flecha {
    --hueco: var(--marino);
  }
  .opcion.jugador .flecha {
    --hueco: var(--medio);
  }
  .hoja {
    position: absolute;
    left: -6px;
    bottom: -14px;
    width: 70px;
    height: 95px;
    color: white;
    opacity: 0.12;
    transform: rotate(-12deg);
  }

  /* ---------------- Explora ---------------- */
  .explorar {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2.2rem 1.5rem 1rem;
  }
  .separador {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
  }
  .separador .linea {
    width: 40px;
    height: 2px;
    background: var(--gris);
  }
  .florcita {
    width: 2.2rem;
    height: 2.2rem;
    color: var(--cielo);
  }
  .explorar h2 {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0.2rem 0 1.6rem;
    font-family: var(--titulos);
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    font-weight: 800;
    color: var(--marino);
  }
  .explorar h2::before,
  .explorar h2::after {
    content: "";
    flex: 1;
    height: 3px;
    border-radius: 3px;
    background: var(--claro);
  }
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
  }
  .tarjeta {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.4rem 1.3rem 2.2rem;
    overflow: hidden;
    background: white;
    border-radius: 18px;
    color: var(--marino);
    box-shadow: 0 8px 22px -10px rgba(20, 59, 97, 0.35);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .tarjeta:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px -12px rgba(20, 59, 97, 0.45);
  }
  .icono-tarjeta {
    width: 4rem;
    height: 4rem;
    flex: none;
    color: var(--azul);
  }
  .tarjeta .texto {
    flex: 1;
  }
  .tarjeta h3 {
    margin: 0;
    font-family: var(--titulos);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .tarjeta p {
    margin: 0.1rem 0 0;
    font-size: 0.95rem;
  }
  .tarjeta .flecha {
    width: 2rem;
    height: 2rem;
    flex: none;
    color: var(--azul);
  }
  .ola {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 22px;
  }
  .ola path {
    fill: var(--claro);
  }

  .estado-servidor {
    display: flex;
    justify-content: center;
    padding: 1.6rem 1rem 0.5rem;
  }

  /* ---------------- Pie ---------------- */
  .pie {
    margin-top: 1.5rem;
  }
  .ola-pie {
    display: block;
    width: 100%;
    height: 50px;
    margin-bottom: -1px;
  }
  .ola-pie path {
    fill: var(--marino);
  }
  .greca {
    display: block;
    width: 100%;
    height: 70px;
  }

  /* ---------------- Celular y tableta ---------------- */
  @media (max-width: 980px) {
    .marca {
      border-right: 0;
      padding-right: 0;
    }
    .accesos {
      margin-left: 0;
    }
    .tarjetas {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .portada {
      grid-template-columns: 1fr;
      padding-top: 1.5rem;
    }
    .ilustracion {
      max-width: 420px;
      margin: 0 auto;
    }
    .opciones {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 0.5rem;
    }
    .barra nav a {
      padding: 0.45rem 0.8rem;
    }
    .accesos {
      width: 100%;
    }
    .pildora {
      flex: 1;
      justify-content: center;
    }
    .petalos {
      display: none;
    }
    .rayitas {
