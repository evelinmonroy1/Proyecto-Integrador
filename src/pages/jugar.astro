---
import Navbar from "../components/Navbar.astro";
import Base from "../layouts/Base.astro";
import JugadorEntrada from "../components/JugadorEntrada.svelte";
---
<Base titulo="Jugar · Lotería Mazahua">
  <Navbar />
  <main>
    <header>
      <a href="/">← Inicio</a>
      <h1>Lotería <span>Mazahua</span></h1>
    </header>
    <JugadorEntrada client:load />
  </main>
</Base>

<style>
  main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }
  header a {
    color: var(--verde);
    font-weight: bold;
    text-align: left;
  }
  h1 {
    font-size: clamp(2rem, 8vw, 2.8rem);
  }
  h1 span {
    color: var(--terracota-oscuro );
  }
</style>