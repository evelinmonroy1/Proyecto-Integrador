---
import Base from "../layouts/Base.astro";
import Navegacion from "../components/Navegacion.astro";
import "../styles/secciones.css";
import { videos } from "../data/videos.js";

// Saca el identificador de un enlace de YouTube (watch?v=, youtu.be/, shorts/, embed/)
function idYoutube(enlace) {
  if (!enlace) return null;
  const m = enlace.match(/(?:v=|youtu\.be\/|shorts\/|embed\/)([\w-]{11})/);
  return m ? m[1] : null;
}

const lista = videos.map((v) => ({ ...v, id: idYoutube(v.youtube) }));
---
<Base titulo="Videos · Lotería Mazahua">
  <div class="tema-info">
    <div class="franja"></div>
    <Navegacion activa="videos" />

    <main>
      <header>
        <span class="etiqueta">Mira · Escucha · Aprende</span>
        <h1>Videos</h1>
        <p class="cursiva">El jñatjo en movimiento.</p>
      </header>

      <section class="videos">
        {lista.map((v, i) => (
          <article class="video">
            <div class="pantalla">
              {v.id ? (
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${v.id}`}
                  title={v.titulo}
                  loading="lazy"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              ) : v.archivo ? (
                <video src={v.archivo} controls preload="metadata"></video>
              ) : (
                <div class="proximamente">
                  <span class="play">▶</span>
                  <span class="etiqueta">Próximamente</span>
                </div>
              )}
            </div>
            <div class="texto">
              <span class="numero">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h2>{v.titulo}</h2>
                {v.descripcion && <p>{v.descripcion}</p>}
              </div>
            </div>
          </article>
        ))}
      </section>
    </main>
    <div class="franja"></div>
  </div>
</Base>

<style>
  main {
    max-width: 1150px;
    margin: 0 auto;
    padding: 0 clamp(1.4rem, 5vw, 3rem) 5rem;
  }
  header {
    padding: clamp(3.5rem, 10vh, 6rem) 0 3.5rem;
  }
  h1 {
    font-size: clamp(3.5rem, 10vw, 6.5rem);
    line-height: 0.95;
  }
  header .cursiva {
    margin: 0.8rem 0 0;
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
  }
  .videos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 460px), 1fr));
    gap: 4rem 2.5rem;
  }
  .pantalla {
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    background: var(--azul-claro);
  }
  .pantalla iframe,
  .pantalla video {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: #000;
  }
  .proximamente {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: linear-gradient(135deg, #eaf4fb, #d6e9f7);
  }
  .proximamente .etiqueta {
    margin: 0;
  }
  .play {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    padding-left: 0.25rem;
    border-radius: 50%;
    border: 1px solid var(--azul);
    color: var(--azul);
    font-size: 1.2rem;
  }
  .texto {
    display: flex;
    gap: 1.2rem;
    padding-top: 1.4rem;
  }
  .numero {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--azul);
    padding-top: 0.2rem;
  }
  .texto h2 {
    font-size: 1.6rem;
    line-height: 1.2;
  }
  .texto p {
    margin: 0.5rem 0 0;
    color: var(--suave);
  }
</style>